Kubernetes - Pod with volume Mount
apiVersion: v1
kind: pod
metadata:
  name: ankit-pod
spec:
  container:
     - name: web
       image: nginx
       volumeMounts:
          - mounthPath: /usr/share/nginx/html
            name: html-volume
   volume:
     - name: html-volume
       hostPath:
         path: /data
         type: Directory

Shell script - check for running service

#!/bin/bash
service=("nginx" docker" "httpd"
for service in "${service[@]}"
do
  if systemctl is-active --quite $service; them
    echo "$service is running
  else
    echo "$service is not running"
  fi
 done

